		/* ----- horizontal menu ----- */
		#horizontal-menu {
			height: 80px;
			background-color: rgba(227, 224, 217, 0.7);
			margin-left: 0;
			position: sticky;
			top: 20px;
			z-index: 2;
		}

		.menu-h {
			list-style-type: none;
			float: left;
		}

		.social-menu {
			float: left;
		}

		.menu-h ul {
			height: 80px;
		}

		.menu-h ul li .sub-menu li a,
		.menu-mainmenu-h-inglese ul li .sub-menu li a {
			line-height: 44px;
		}

		.menu-h ul.menu li.menu-item.menu-item-type-post_type.menu-item-object-page.menu-item-has-children.menu-item-9541 {
			position: relative;
		}

		.menu-h .sub-menu,
		.menu-mainmenu-h-inglese .sub-menu {
			margin-left: 0;
			left: -9999px;
			opacity: 0;
			bottom: -79px;
			position: absolute;
			-webkit-transition: opacity .4s ease-in-out;
			-moz-transition: opacity .4s ease-in-out;
			-ms-transition: opacity .4s ease-in-out;
			-o-transition: opacity .4s ease-in-out;
			transition: opacity .4s ease-in-out;
			width: 200px;
			z-index: 999;
		}

		.menu-h ul li.current-menu-item li a {
			color: #333;
		}


		.menu-h .sub-menu {
			width: 120px;
		}

		.menu-h .sub-menu li,
		.menu-mainmenu-h-inglese .sub-menu li {
			height: auto;
			background-color: rgba(227, 224, 217, 0.7);
			border: 2px solid rgba(227, 224, 217, 0.7);
			width: 100%;
		}

		.menu-h .sub-menu a,
		.menu-mainmenu-h-inglese .sub-menu a {

			border-top: none;
			color: #333;
			font-size: 14px;
			padding: 10px 5px;
			position: relative;
			width: 200px;
			font-weight: normal;
		}

		.menu-h .sub-menu a:hover,
		.menu-mainmenu-h-inglese .sub-menu a:hover {
