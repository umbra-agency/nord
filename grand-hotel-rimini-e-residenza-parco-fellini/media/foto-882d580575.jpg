

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0, viewport-fit=cover" />
    <title>404 Page Not Found</title>
    <style type="text/css">
        html {
            font-family: 'Roboto', sans-serif;
            font-size: 10px;
        }

        .App {
            display: block;
            height: 100vh;
            left: 0;
            position: fixed;
            top: 0;
            width: 100%;
            -webkit-overflow-scrolling: touch;
        }

        .App__Animation {
            position: absolute;
            transform: translate(0, 100%) translateZ(0) scale(3);
        }

        .App__Message {
            bottom: 25vw;
            left: 0;
            margin: 0 auto;
            position: absolute;
            right: 0;
            text-align: center;
            text-transform: uppercase;
            width: 90%;
        }

            .App__Message h1 {
                color: #9eb307;
                font-size: 10rem;
                margin: 0;
            }

            .App__Message h4 {
                color: #8f8f8f;
                font-size: 2rem;
                margin: 0;
            }

        @media only screen and (min-width: 768px) {
            html {
                font-size: 15px;
            }

            .App__Animation {
                height: 90%;
                position: relative;
                transform: translate(0, 5%) translateZ(0) scale(2.5);
            }

            .App__Message {
                bottom: 5%;
                left: 50%;
                right: auto;
                transform: translate(-50%, 0);
                width: 100%;
            }
        }

        @media only screen and (min-width: 1024px) {
            .App__Animation {
                transform: none;
            }

            .App__Message {
                bottom: 12%;
            }
        }
    </style>
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.5.7/lottie.min.js" type="text/javascript"></script>
</head>
<body style="overflow: hidden; margin: 0;">
    <a id="app" class="App" href="/" style="opacity: 0;">
        <div id="animation" class="App__Animation"></div>
        <div class="App__Message">
            <h1>404</h1>
            <h4>Oops! Something went wrong!</h4>
        </div>
    </a>
    <script type="text/javascript">
        var client = new XMLHttpRequest();
		client.open("GET", 'https://hoteldoor.blob.core.windows.net/assets/animations/404.json?st=1993-07-20T08%3A00%3A00Z&se=2193-07-20T08%3A00%3A00Z&sp=rl&sv=2018-03-28&sr=b&sig=wmcEHZftqULrIdrr6SPNaWZx%2BxsjOFhn%2B7dG%2BOIbBuE%3D', false);
		client.send();
		var data = JSON.parse(client.responseText);

		var animation = lottie.loadAnimation({
			container: document.getElementById('animation'),
			renderer: 'svg',
			loop: true,
			autoplay: true,
			animationData: data
		});
		animation.onEnterFrame = function ()
		{
			document.getElementById('app').removeAttribute('style');
        };
    </script>
</body>
</html>